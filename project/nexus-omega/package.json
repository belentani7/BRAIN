{
  "name": "nexus-omega",
  "version": "1.0.0",
  "description": "AI Workforce Control Plane / Agent Operating System",
  "type": "module",
  "scripts": {
    "dev": "tsx src/app/index.ts",
    "build": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "tsx tests/run-all.ts",
    "test:unit": "tsx tests/unit/*.test.ts",
    "test:integration": "tsx tests/integration/*.test.ts",
    "test:e2e": "tsx tests/e2e/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "audit:ledger": "tsx src/audit/verify-ledger.ts",
    "ingest:github": "tsx src/ingestion/github-ingest.ts",
    "mission:run": "tsx src/app/mission-runtime.ts"
  },
  "dependencies": {
    "@octokit/graphql": "^8.1.0",
    "@octokit/rest": "^21.0.0",
    "@prisma/client": "^5.22.0",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "pino": "^9.4.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.10.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
